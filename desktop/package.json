{
  "name": "@cenacle/desktop",
  "version": "0.29.0",
  "private": true,
  "description": "Cenacle desktop app (Electron) for Windows and Linux.",
  "license": "AGPL-3.0-only",
  "author": "Cenacle contributors",
  "homepage": "https://git.calaixo.com/calaxio/cenacle",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-pages.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && electron .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm build && playwright test",
    "icons": "node scripts/icons.mjs",
    "dist": "pnpm build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "desktopName": "cenacle.desktop"
}
