# Cenacle local development configuration.
# Copy to .env (git-ignored): cp .env.example .env
# Values are plain KEY=value (no quotes): the Makefile and Compose both read this file.
# These passwords are for local development only. Never reuse them in production.

# --- Infrastructure (deploy/compose/dev.yml) ---------------------------------
POSTGRES_PORT=15432
POSTGRES_PASSWORD=postgres-dev-password
CHAT_DB_NAME=cenacle_chat
CHAT_DB_USER=cenacle_chat
CHAT_DB_PASSWORD=chat-dev-password
IDP_DB_NAME=cenacle_idp
IDP_DB_USER=cenacle_idp
IDP_DB_PASSWORD=idp-dev-password

VALKEY_PORT=16379

LDAP_PORT=13389
LDAP_ADMIN_PASSWORD=ldap-dev-password

MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025

# Ports of the optional "apps" profile containers.
SERVER_APP_PORT=18180
IDP_APP_PORT=18190
WEB_APP_PORT=18080

# --- Chat server (make dev-server) -------------------------------------------
CENACLE_ENV=development
CENACLE_HTTP_ADDR=127.0.0.1:8180
CENACLE_LOG_LEVEL=info
CENACLE_DATABASE_URL=postgres://cenacle_chat:chat-dev-password@127.0.0.1:15432/cenacle_chat?sslmode=disable
CENACLE_VALKEY_ADDR=127.0.0.1:16379

# --- Identity server, Cenacle ID (make dev-idp) ------------------------------
IDP_ENV=development
IDP_HOST=127.0.0.1
IDP_PORT=8190
IDP_LOG_LEVEL=info
# Public issuer URL. Production example: https://id.example.com
IDP_ISSUER=http://localhost:8190
# Empty = host-only cookies. Production example: example.com
IDP_COOKIE_DOMAIN=
IDP_DATABASE_URL=postgres://cenacle_idp:idp-dev-password@127.0.0.1:15432/cenacle_idp
# Development-only secrets (deploy/compose/gen-secrets.sh creates real ones).
# 32-byte key, base64: encrypts token signing keys at rest.
IDP_KEY_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWVuY3J5cHRpb24ta2V5LTMyYiE=
# Cookie signing keys (newest first, comma separated, >= 32 characters each).
IDP_COOKIE_KEYS=dev-only-cookie-key-0123456789abcdef
# Registered OIDC clients (development: the local chat server).
IDP_CLIENTS_FILE=dev/clients.json

# --- Web app (make dev-web) --------------------------------------------------
WEB_PORT=5173
