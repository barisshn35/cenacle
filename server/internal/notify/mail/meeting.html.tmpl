<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Subject}}</title>
<style>
  body { margin: 0; padding: 0; }
  a { color: inherit; }
  @media (prefers-color-scheme: dark) {
    .page { background: #0f1311 !important; }
    .card { background: #18201c !important; border-color: #2c3631 !important; }
    .ink { color: #ecebe6 !important; }
    .muted { color: #a4ada7 !important; }
    .rule { border-color: #2c3631 !important; }
    .date { background: #1d2622 !important; border-color: #2c3631 !important; }
    .date-top { background: #1f4a3d !important; }
    .tint { background: #2b2716 !important; }
    .changed { color: #d4b062 !important; }
    .chip { background: #26302b !important; color: #ecebe6 !important; }
    .head { background: #0f2620 !important; }
  }
  @media (max-width: 620px) {
    .pad { padding-left: 20px !important; padding-right: 20px !important; }
  }
</style>
</head>
<body class="page" style="margin:0;padding:0;background:#f4f3ef;">
<div style="display:none;max-height:0;overflow:hidden;">{{.Preheader}}</div>
<table role="presentation" class="page" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f3ef;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<tr><td align="center" style="padding:28px 12px;">
{{outlook `<table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0"><tr><td>`}}
<table role="presentation" class="card" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background:#ffffff;border:1px solid #e3e1da;border-radius:10px;border-collapse:separate;overflow:hidden;">
  <tr><td class="head pad" style="background:#14342b;padding:16px 28px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
      <td style="vertical-align:middle;"><img src="cid:logo" width="22" height="22" alt="" style="display:inline-block;vertical-align:middle;border:0;"><span style="color:#ffffff;font-size:17px;font-weight:600;letter-spacing:-0.01em;vertical-align:middle;margin-left:8px;">Cenacle</span></td>
      <td align="right" style="color:#c6d6cf;font-size:13px;vertical-align:middle;">{{.Workspace}}</td>
    </tr></table>
  </td></tr>
  <tr><td class="pad" style="padding:28px 28px 8px;">
    <p class="muted" style="margin:0 0 6px;font-size:15px;line-height:1.45;color:#5b655f;">{{.Lead}}</p>
    <h1 class="ink" style="margin:0;font-size:24px;line-height:1.25;font-weight:600;letter-spacing:-0.01em;color:{{if .Cancelled}}#5b655f{{else}}#1e2b26{{end}};">{{.Title}}{{if .Cancelled}} <span class="chip" style="display:inline-block;vertical-align:4px;font-size:12px;font-weight:600;color:#1e2b26;background:#ebe9e2;border-radius:999px;padding:2px 10px;letter-spacing:0;">{{.CancelledLabel}}</span>{{end}}</h1>
  </td></tr>
  <tr><td class="pad" style="padding:18px 28px 6px;">
    <table role="presentation" cellpadding="0" cellspacing="0"><tr>
      <td style="vertical-align:top;width:76px;">
        <table role="presentation" class="date" width="68" cellpadding="0" cellspacing="0" style="width:68px;border:1px solid #e3e1da;border-radius:8px;border-collapse:separate;overflow:hidden;background:#faf9f6;{{if .Cancelled}}opacity:0.55;{{end}}">
          <tr><td class="date-top" align="center" style="background:#14342b;color:#ffffff;font-size:11px;font-weight:700;letter-spacing:0.08em;padding:3px 0;">{{.Month}}</td></tr>
          <tr><td class="ink" align="center" style="font-size:28px;font-weight:600;line-height:1;color:#1e2b26;padding:8px 0 2px;">{{.Day}}</td></tr>
          <tr><td class="muted" align="center" style="font-size:11px;color:#5b655f;padding:0 0 7px;">{{.Weekday}}</td></tr>
        </table>
      </td>
      <td style="vertical-align:top;padding-left:14px;">
        {{if .TimeChanged}}<div class="tint" style="display:inline-block;background:#f7f0dc;border-radius:6px;padding:2px 8px;margin:-2px 0 4px -8px;"><span class="ink" style="font-size:18px;font-weight:600;color:#1e2b26;">{{.Time}}</span> <span class="changed" style="font-size:12px;font-weight:600;color:#8f6b1f;margin-left:6px;">{{.ChangedLabel}}</span></div>
        <div class="muted" style="font-size:13px;color:#5b655f;">{{.WasLabel}} <s>{{.OldTime}}</s></div>
        {{else}}<div class="ink" style="font-size:18px;font-weight:600;color:{{if .Cancelled}}#5b655f;text-decoration:line-through{{else}}#1e2b26{{end}};">{{.Time}}</div>{{end}}
        <div class="muted" style="font-size:13px;color:#5b655f;margin-top:2px;">{{.Zone}}</div>
        {{if .Repeat}}<div class="muted" style="font-size:13px;color:#5b655f;">{{.Repeat}}</div>{{end}}
      </td>
    </tr></table>
  </td></tr>
  <tr><td class="pad" style="padding:14px 28px 4px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      {{range .Rows}}<tr><td class="rule muted" style="padding:10px 0;border-top:1px solid #e3e1da;width:112px;vertical-align:top;color:#5b655f;font-size:13px;">{{.Label}}</td>
      <td class="rule ink" style="padding:10px 0;border-top:1px solid #e3e1da;vertical-align:top;color:#1e2b26;font-size:14px;line-height:1.5;">{{range $i, $l := .Lines}}{{if $i}}<br>{{end}}{{$l}}{{end}}</td></tr>
      {{end}}
    </table>
  </td></tr>
  <tr><td class="pad" style="padding:18px 28px 6px;">
    <table role="presentation" cellpadding="0" cellspacing="0"><tr>
      {{if .Cancelled}}<td class="rule" style="border:1px solid #e3e1da;border-radius:8px;"><a class="ink" href="{{.ButtonURL}}" style="display:inline-block;padding:11px 20px;font-size:15px;font-weight:600;color:#1e2b26;text-decoration:none;">{{.Button}}</a></td>
      {{else}}<td style="background:#c9a24b;border:1px solid #c9a24b;border-radius:8px;"><a href="{{.ButtonURL}}" style="display:inline-block;padding:11px 20px;font-size:15px;font-weight:600;color:#14342b;text-decoration:none;">{{.Button}}</a></td>{{end}}
    </tr></table>
    <p class="muted" style="margin:12px 0 0;font-size:13px;line-height:1.5;color:#5b655f;">{{.Hint}}</p>
  </td></tr>
  <tr><td class="pad" style="padding:12px 28px 24px;">
    <p class="muted" style="margin:0;font-size:13px;color:#5b655f;">{{.CalendarNote}}</p>
  </td></tr>
  <tr><td class="pad rule" style="padding:16px 28px 22px;border-top:1px solid #e3e1da;">
    <p class="muted" style="margin:0 0 6px;font-size:12px;line-height:1.5;color:#5b655f;">{{.Footer}}</p>
    <p class="muted" style="margin:0;font-size:12px;color:#5b655f;">{{.Host}}</p>
  </td></tr>
</table>
{{outlook `</td></tr></table>`}}
</td></tr></table>
</body>
</html>
