# WAL-G settings for backup.yml (copy to secrets/walg.env, mode 600).
# Any S3 service; keep it off this host. https://wal-g.readthedocs.io
WALG_S3_PREFIX=s3://cenacle-backups/postgres
AWS_ENDPOINT=https://s3.backup.example.com
AWS_REGION=us-east-1
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WALG_COMPRESSION_METHOD=zstd
# Optional: base backups every N seconds (default 86400) and full backups kept.
WALG_BACKUP_INTERVAL=86400
WALG_RETAIN_FULL=7
