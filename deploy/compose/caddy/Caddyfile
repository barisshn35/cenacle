# Public entry point. Host names come from the environment (.env.prod), never
# from code: CENACLE_DOMAIN (chat) and CENACLE_ID_DOMAIN (Cenacle ID).
{
	admin off
}

# TLS mode, chosen with CENACLE_TLS_MODE in .env.prod:
#   acme      automatic certificates from Let's Encrypt (default; needs ports 80/443
#             reachable from the internet), with ACME_EMAIL for certificate notices
#   files     your own certificate: certs/tls.crt (full chain) and certs/tls.key
#   internal  Caddy's internal CA (testing or closed networks; clients must trust it)
# ACME_EMAIL is needed in mode acme only: without it the configuration is
# invalid (prod.yml checks it first and says so).
(tls-acme) {
	tls {$ACME_EMAIL}
}
(tls-files) {
	tls /certs/tls.crt /certs/tls.key
}
(tls-internal) {
	tls internal
}

# Browsers keep to https for a year once they have seen it (subdomains are
# left alone: they may serve other things).
(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

(calls-off) {
 handle /media/* {
  respond 404
 }
}
(calls-on) {
 handle /media/* {
  @signal path /media/ws
  handle @signal {
   reverse_proxy media:7880 {
    stream_close_delay 5m
   }
  }
  handle {
   respond 404
  }
 }
}

(chat-servers) {
	dynamic a server 8180 {
		refresh 5s
	}
	lb_policy least_conn
	lb_try_duration 10s
	fail_duration 15s
}

{$CENACLE_DOMAIN} {
	import tls-{$CENACLE_TLS_MODE:acme}
	import security
	encode zstd gzip

	# API, WebSocket and the chat server's health checks go to the chat server;
	# everything else is the SPA.
	# Every instance of the chat server is found by its Compose service name
	# (`docker compose up --scale server=N`); a request to an instance that is
	# stopping is retried on another one.
	@chat path /api/* /healthz /readyz
	handle @chat {
		reverse_proxy {
			import chat-servers
		}
	}
	import calls-{$CENACLE_CALLS:off}
	handle /ws* {
		# WebSockets have no proxy idle timeout; the server pings every 25 s.
		# Keep upgraded streams open across config reloads.
		reverse_proxy {
			import chat-servers
			stream_close_delay 5m
		}
	}
	# Uploads go from the browser straight to the object store, with a signed
	# form the server issued (fixed key and size). Only those form posts to the
	# bucket pass; every other S3 request stays inside.
	@upload {
		method POST
		path /{$CENACLE_S3_BUCKET:cenacle-files} /{$CENACLE_S3_BUCKET:cenacle-files}/
	}
	handle @upload {
		reverse_proxy garage:3900
	}
	handle {
		reverse_proxy web:8080
	}
}

# The proxy's own health check (prod.yml), reachable only inside its container.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz 200
	respond 404
}

{$CENACLE_ID_DOMAIN} {
	import tls-{$CENACLE_TLS_MODE:acme}
	import security
	encode zstd gzip
	reverse_proxy idp:8190
}
