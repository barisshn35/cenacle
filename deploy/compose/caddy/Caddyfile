# Public entry point. Host names come from the environment (.env.prod), never
# from code: CENACLE_DOMAIN (chat) and CENACLE_ID_DOMAIN (Cenacle ID).
{
	email {$ACME_EMAIL}
	admin off
}

# TLS mode, chosen with CENACLE_TLS_MODE in .env.prod:
#   acme      automatic certificates from Let's Encrypt (default; needs ports 80/443
#             reachable from the internet)
#   files     your own certificate: certs/tls.crt (full chain) and certs/tls.key
#   internal  Caddy's internal CA (testing or closed networks; clients must trust it)
(tls-acme) {
}
(tls-files) {
	tls /certs/tls.crt /certs/tls.key
}
(tls-internal) {
	tls internal
}

{$CENACLE_DOMAIN} {
	import tls-{$CENACLE_TLS_MODE:acme}
	encode zstd gzip

	# API and WebSocket go to the chat server; everything else is the SPA.
	handle /api/* {
		reverse_proxy server:8180
	}
	handle /ws* {
		# WebSockets have no proxy idle timeout; the server pings every 25 s
		# (v0.4). Keep upgraded streams open across config reloads.
		reverse_proxy server:8180 {
			stream_close_delay 5m
		}
	}
	# Uploads go from the browser straight to the object store, with a signed
	# form the server issued (fixed key and size). Only those form posts to the
	# bucket pass; every other S3 request stays inside.
	@upload {
		method POST
		path /{$CENACLE_S3_BUCKET:cenacle-files} /{$CENACLE_S3_BUCKET:cenacle-files}/
	}
	handle @upload {
		reverse_proxy garage:3900
	}
	handle {
		reverse_proxy web:8080
	}
}

{$CENACLE_ID_DOMAIN} {
	import tls-{$CENACLE_TLS_MODE:acme}
	encode zstd gzip
	reverse_proxy idp:8190
}
