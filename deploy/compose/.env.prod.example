# Production settings for deploy/compose/prod.yml (copy to .env.prod).
# Host names are configuration, never code: use any domain or subdomain.
CENACLE_VERSION=0.37.0
CENACLE_IMAGE_PREFIX=git.calaixo.com:5050/calaxio/cenacle/cenacle-
CENACLE_DOMAIN=chat.example.com
CENACLE_ID_DOMAIN=id.example.com
ACME_EMAIL=admin@example.com
# TLS: acme (Let's Encrypt, default) | files (certs/tls.crt + certs/tls.key) | internal
CENACLE_TLS_MODE=acme
# Optional: share IdP cookies across subdomains, e.g. example.com
IDP_COOKIE_DOMAIN=
# The instance administrator (its Cenacle ID e-mail address, verified): owns the
# first workspace, creates workspaces and posts in the announcement channel.
CENACLE_ADMIN_EMAIL=admin@example.com
# Channels created at installation, with everyone as a member. The announcement
# channel cannot be left and only the administrator posts there (empty: none).
CENACLE_ANNOUNCEMENT_CHANNEL=Central
# Comma-separated; names may contain spaces.
CENACLE_DEFAULT_CHANNELS=General
# Bots' servers (slash commands, event subscriptions) must be on the internet unless
# their networks are listed here, comma-separated (e.g. 10.20.0.0/16,192.168.5.10).
# Loopback, private and link-local addresses are refused otherwise.
CENACLE_EGRESS_ALLOW=
# Previews of links in messages (the server fetches the pages); false without internet.
CENACLE_LINK_PREVIEWS=true
# Files: the bundled Garage by default. Empty: files off; or your own S3 service
# (then also CENACLE_S3_REGION, CENACLE_S3_BUCKET and the keys in secrets/).
# CENACLE_S3_ENDPOINT=
CENACLE_FILES_MAX_SIZE_MB=100
# Virus scanning of uploads: start with --profile clamav and set clamav:3310.
CENACLE_CLAMAV_ADDR=
# How long a stopping chat server keeps serving while the proxy moves away.
CENACLE_DRAIN_DELAY=5s
# E-mail about mentions and direct messages people missed (they turn it on in their
# notification settings). Empty host: no e-mail. Security: starttls (587), tls (465)
# or none (a relay on a trusted network).
CENACLE_SMTP_HOST=
CENACLE_SMTP_PORT=587
CENACLE_SMTP_SECURITY=starttls
CENACLE_SMTP_USERNAME=
# Password: here or in secrets/smtp_password (not both).
CENACLE_SMTP_PASSWORD=
CENACLE_SMTP_FROM=Cenacle <chat@example.com>
# Web push: notifications on devices where no Cenacle tab is open. Messages go
# encrypted through the browser makers' push services, so the server needs to reach
# them (off in air-gapped installations). The subject is a contact for those services
# (default: mailto: and CENACLE_ADMIN_EMAIL).
CENACLE_WEB_PUSH=false
CENACLE_WEB_PUSH_SUBJECT=mailto:admin@example.com
# Database connections one chat server keeps (mind PostgreSQL's max_connections).
CENACLE_DATABASE_MAX_CONNS=25
# Optional AI (off unless set): an OpenAI-compatible API of a model you run, e.g.
# Ollama (http://ollama:11434/v1) or vLLM. Workspaces still turn AI on themselves.
CENACLE_AI_URL=
CENACLE_AI_MODEL=
# API key, if the model server wants one: here or in secrets/ai_api_key (not both).
CENACLE_AI_API_KEY=
# Longest wait for an answer.
CENACLE_AI_TIMEOUT=2m
# People stay signed in until they sign out (none). To end signed-in devices after a time
# unused and at the latest after a maximum age, set durations such as 168h and 720h.
CENACLE_SESSION_IDLE_TIMEOUT=none
CENACLE_SESSION_MAX_AGE=none
# Force the web app on or off whatever the administrators chose (recovery).
# CENACLE_WEB_APP=on
# Logs: debug, info, warn or error.
CENACLE_LOG_LEVEL=info
IDP_LOG_LEVEL=info
# Sign-in attempts per address and minute at Cenacle ID. Raise it when many people
# share one public address (NAT), e.g. 100.
IDP_LOGIN_RATE_LIMIT=10
