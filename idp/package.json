{
  "name": "@cenacle/idp",
  "version": "0.1.1",
  "private": true,
  "description": "Cenacle ID: the identity server (OpenID Provider) of Cenacle.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx --env-file-if-exists=../.env src/cli.ts"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.7",
    "node-pg-migrate": "9.0.0",
    "oidc-provider": "9.12.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "openid-client": "6.8.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "bin": {
    "cenacle-idp": "dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "public"
  ]
}
