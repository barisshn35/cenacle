{
  "name": "@cenacle/idp",
  "version": "0.99.4",
  "private": true,
  "description": "Cenacle ID: the identity server (OpenID Provider) of Cenacle.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/build-assets.mjs && tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "cli": "tsx --env-file-if-exists=../.env src/cli.ts",
    "build:assets": "node scripts/build-assets.mjs",
    "test:e2e": "node scripts/build-assets.mjs && playwright test"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.1",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@node-saml/node-saml": "5.1.0",
    "@prometheus-io/client": "0.16.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "ldapts": "9.2.0",
    "node-pg-migrate": "9.0.0",
    "oidc-provider": "9.12.2",
    "openid-client": "6.8.8",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cenacle/ui": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.2",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "xml-crypto": "6.4.0"
  },
  "bin": {
    "cenacle-idp": "dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "public"
  ]
}
