{
  "name": "@cenacle/web",
  "version": "0.3.0",
  "private": true,
  "description": "Cenacle web app (React SPA).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e-stack": "playwright test -c playwright.stack.config.ts"
  },
  "dependencies": {
    "@cenacle/core": "workspace:*",
    "@cenacle/ui": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "i18next": "26.5.3",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "sonner": "2.0.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
