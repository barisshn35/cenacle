# Static file server for the Cenacle web app (runs as a non-root user).
{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		# No third-party origins: scripts, styles, fonts and images are self-hosted.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# Voice messages and video clips record here; nothing else may.
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		-Server
	}

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html /sw.js
	header @html Cache-Control "no-cache"

	respond /healthz 200

	# Desktop app installers and update files, put on the downloads volume by
	# the administrators (docs/install/desktop.md). Missing files are 404, not
	# the app.
	handle_path /downloads/* {
		root * /downloads
		header Cache-Control "no-cache"
		file_server
	}

	# SPA routing: unknown paths fall back to index.html.
	handle {
		try_files {path} /index.html
		file_server
	}
}
