# Build context is the repository root; keep it small and secret-free.
.git
.env
.env.*
!.env.example
**/node_modules
**/dist
**/coverage
**/test-results
**/playwright-report
.bin
server/bin
docs
# Only the Caddy sources and the proxy config are needed from deploy/.
deploy/*
!deploy/caddy
!deploy/compose
deploy/compose/*
!deploy/compose/caddy
